{
  "compilerOptions": {
      "target": "ES2020",
      "module": "commonjs",
      "moduleResolution": "node",
      "ignoreDeprecations": "6.0",
      "rootDir": "./src",
      "outDir": "./dist",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true
  },
  "include": [
      "src/**/*.ts",
      "src/**/*.d.ts"
  ],
  "ts-node": {
      "files": true
  }
}